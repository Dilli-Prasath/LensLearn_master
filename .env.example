# LensLearn — Environment Variables
# Copy this file to .env and fill in your values.

# Ollama Cloud API Key (PREFERRED — uses real Gemma 4 models in the cloud)
# 1. Sign in: ollama signin
# 2. Get key: https://ollama.com/settings/keys
VITE_OLLAMA_API_KEY=your-ollama-api-key-here

# Google AI Studio API Key (fallback — uses Gemini Flash)
# Get yours free at: https://aistudio.google.com/apikey
VITE_GOOGLE_AI_KEY=your-google-ai-api-key-here
# (paste your key above)
